DATABASE_URL=
DATABASE_URL_UNPOOLED=
JOB_DESK_ENABLE_SEED=false
# Shared secret for the whole app. Required in production (NODE_ENV=production);
# when missing, every request is refused. Omitted locally = no login needed.
JOB_DESK_ACCESS_TOKEN=
# true = read-only public showcase: serves lib/seed.ts data (ignores DATABASE_URL),
# refuses every write, and needs no access token.
JOB_DESK_PUBLIC_DEMO=false
CRON_SECRET=
